  "narrative": {
    "northStar": "The Evidence Catalogue",
    "overview": "SentinelAI uses an evidence catalogue as its visual reference: a stable navy navigation rail, neutral work surfaces, restrained teal actions, and compact records that keep sources close to interpretations. The user specified this palette and the human-review purpose. “The Evidence Catalogue” names that implemented direction; it is descriptive documentation, not an independently approved visual comp.\n\nThe recognizable pattern is timestamped evidence navigation. Transcript rows, event times, and source citations seek the same evidence player; source labels distinguish synthetic material from uploads, while review forms place a written rationale before a recorded human decision. The visual system supports inspection and comparison with familiar controls and limited motion.\n\nThis document refreshes provisional files created during the same implementation. It describes the final CSS cascade and components, including their compact exceptions. It is a source-derived design reference, not a claim of complete accessibility conformance or a substitute for rendered verification.",
    "keyCharacteristics": [
      "Navy navigation, pale neutral canvas, and bordered white working panels.",
      "Teal actions, named risk states, and explicit source provenance.",
      "Compact system typography with monospaced identifiers and timecodes.",
      "Timestamp navigation, visible uncertainty, and reasoned human review.",
      "Responsive stacked workspaces with native forms, media controls, and confirmation dialogs."
    ],
    "rules": [
      {
        "name": "The Source First Rule.",
        "body": "A color state must retain its readable risk name, source label, or action label. Color alone does not communicate provenance or a review outcome.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule.",
        "body": "Keep ordinary evidence and governance panels border-defined; use shadow for the implemented temporary-layer roles.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the user’s navy/slate, neutral, teal, amber, and red palette.",
      "Do keep risk names and source labels visible alongside color.",
      "Do make evidence citations seek the persisted source timestamp and preserve the unavailable-media message.",
      "Do keep human rationale, confirmation, and recorded history together in review workflows.",
      "Do retain the implemented focus treatment, native form semantics, and reduced-motion rules when adding components.",
      "Do check the final CSS cascade at desktop and mobile sizes before extending density rules."
    ],
    "donts": [
      "Don’t present synthetic scripts, rule interpretations, or missing analysis as real model findings.",
      "Don’t style a risk score as a determination of guilt or as an external emergency dispatch.",
      "Don’t assume every supporting label is 12px or every control has a 44px target; the current interface contains documented density exceptions.",
      "Don’t replace the system font stack with a display font or add decorative motion to routine evidence work.",
      "Don’t turn generated preview tonal ramps into application tokens without a deliberate implementation change."
    ]
  }
