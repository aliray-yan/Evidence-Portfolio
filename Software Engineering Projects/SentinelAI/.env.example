# Documentation template. Set these in your process environment; .env is not auto-loaded.
SENTINEL_DEMO=1
SENTINEL_DATA_DIR=.local/data
SENTINEL_WORKERS=1
SENTINEL_SECURE_COOKIE=0
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
# Non-demo operation requires a Fernet key from your secret manager.
# SENTINEL_ENCRYPTION_KEY=
# Optional local directory containing faster-whisper / CTranslate2 model weights.
# SENTINEL_WHISPER_MODEL=
