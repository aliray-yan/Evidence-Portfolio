# Documentation template. Set these in your process environment; .env is not auto-loaded.
SENTINEL_DEMO=1
# Authenticated local synthetic video downloads; also enabled in demo mode.
SENTINEL_TEST_VIDEOS=0
# Dedicated test environments label all new uploads; mobile helper enables this.
SENTINEL_TEST_UPLOADS=0
SENTINEL_DATA_DIR=.local/data
SENTINEL_WORKERS=1
SENTINEL_SECURE_COOKIE=0
SENTINEL_ALLOWED_HOSTS=localhost,127.0.0.1
# Non-demo operation requires a Fernet key from your secret manager.
# SENTINEL_ENCRYPTION_KEY=
# Audio analysis was removed. Legacy audio selection variables are ignored.
# Optional verified bundle exported by training/SentinelAI_RWF2000_Kaggle.ipynb.
# SENTINEL_VIOLENCE_MODEL=.local/models/violence-v1

# A model imported with --activate is selected from .local/model-selection.json.
# An explicit SENTINEL_VIOLENCE_MODEL overrides that selection; empty disables it.

# Public local AI setup writes .local/ai-selection.json. Each explicit variable
# overrides that selection; an empty value disables the component.
# SENTINEL_GESTURE_MODEL=
# SENTINEL_POSE_MODEL=
# SENTINEL_FACE_MODEL=
# SENTINEL_OBJECT_MODEL=
# Experimental person/hand/temporal exchange model selection (not currency recognition).
# SENTINEL_EXCHANGE_MODEL=
# Optional screened learned runtime. Only backend.exchange_import installs this package.
# Empty explicitly selects the older baseline; invalid packages fail, never silently fall back.
# SENTINEL_LEARNED_EXCHANGE_MODEL=
# Optional manually triggered signed webhook; always disabled in demo mode.
# SENTINEL_NOTIFICATION_URL=https://your-authorized-provider.example/receive
# SENTINEL_NOTIFICATION_SECRET=<at least 32 characters from a secrets manager>

# Optional historical-evidence search; it does not classify new encounters.
# SENTINEL_RETRIEVAL_MODEL=

# Optional reviewer-triggered cloud reading guide. Prefer setup-openrouter.ps1 on Windows.
# OPENROUTER_API_KEY=<server-side secret only; never commit a real value>
SENTINEL_OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free
SENTINEL_OPENROUTER_REAL_CASES=0
# NVIDIA free requests are restricted to synthetic cases even if the above is enabled.
