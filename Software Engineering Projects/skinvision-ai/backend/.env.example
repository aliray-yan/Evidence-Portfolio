# Copy to .env and adjust as needed. All values are optional; sane
# defaults live in app/config.py.
SKINVISION_ALLOWED_ORIGINS=["http://localhost:3000"]

# Flip to true once you've trained models and dropped checkpoints in
# the paths below (see QUICKSTART.md, Part 4). If a checkpoint is
# missing or torch/ultralytics aren't installed, the app logs a
# warning and falls back to the heuristic placeholder automatically.
SKINVISION_MODELS_ARE_TRAINED=true

# Only read when SKINVISION_MODELS_ARE_TRAINED=true. Defaults shown.
# SKINVISION_CLASSIFIER_CHECKPOINT_PATH=app/ml_models/classifier/best.pt
# SKINVISION_DETECTOR_CHECKPOINT_PATH=app/ml_models/detector/best.pt
