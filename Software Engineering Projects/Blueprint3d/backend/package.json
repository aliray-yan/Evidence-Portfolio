{
  "name": "blueprint3d-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Blueprint3D API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-worker.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate:up": "node-pg-migrate up -m src/db/migrations --envPath .env --ignore-pattern \"(^\\.|^package\\.json$)\"",
    "migrate:down": "node-pg-migrate down -m src/db/migrations --envPath .env --ignore-pattern \"(^\\.|^package\\.json$)\"",
    "migrate:create": "node-pg-migrate create -m src/db/migrations --envPath .env"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "node-pg-migrate": "^9.0.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}