# Shared
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Server
PORT=4000
JWT_SECRET=replace-with-a-long-random-secret
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
MAX_UPLOAD_MB=2

# PostgreSQL + Prisma
DATABASE_URL=postgresql://rag_mastery:12345@127.0.0.1:5433/rag_ai_mastery?schema=public

# RAG playground modes
# mock is free/local-first and works without paid APIs.
RAG_MODE=mock

# Optional OpenAI-compatible API mode.
# Do not commit real keys. Add your own key only in a local .env file.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional Ollama mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Client
VITE_API_URL=http://localhost:4000/api
