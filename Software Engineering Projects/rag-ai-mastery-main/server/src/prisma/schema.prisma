generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SCENARIO
  ORDERING
  CHUNKING_DECISION
  RETRIEVAL_DIAGNOSIS
}

model User {
  id                String            @id @default(cuid())
  name              String
  email             String            @unique
  passwordHash      String
  role              Role              @default(STUDENT)
  streakCount       Int               @default(0)
  lastActiveAt      DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  progress          UserProgress[]
  quizAttempts      QuizAttempt[]
  bookmarks         Bookmark[]
  notes             Note[]
  achievements      UserAchievement[]
  certificates      Certificate[]
  ragDocuments      RagDocument[]
  ragQueryLogs      RagQueryLog[]
}

model Level {
  id             String          @id @default(cuid())
  number         Int             @unique
  title          String
  description    String
  difficulty     String          @default("Beginner")
  sortOrder      Int
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  modules        Module[]
  guidedProjects GuidedProject[]

  @@index([sortOrder])
}

model Module {
  id          String             @id @default(cuid())
  title       String
  description String
  sortOrder   Int
  levelId     String
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  level       Level              @relation(fields: [levelId], references: [id], onDelete: Cascade)
  lessons     Lesson[]
  exercises   PracticeExercise[]

  @@index([levelId, sortOrder])
}

model Lesson {
  id                   String          @id @default(cuid())
  title                String
  slug                 String          @unique
  difficulty           String
  estimatedMinutes     Int
  simpleExplanation    String
  eli10                String
  analogy              String
  whyMatters           String
  technicalExplanation String
  codeExample          String?
  visualIdea           String
  commonMistakes       String[]
  miniPractice         String
  summary              String
  nextLesson           String?
  tags                 String[]
  sortOrder            Int
  moduleId             String
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  module               Module          @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quizQuestions        QuizQuestion[]
  progress             UserProgress[]
  quizAttempts         QuizAttempt[]
  bookmarks            Bookmark[]
  notes                Note[]

  @@index([moduleId, sortOrder])
  @@index([title])
}

model QuizQuestion {
  id            String       @id @default(cuid())
  type          QuestionType
  question      String
  options       Json
  correctAnswer Json
  explanation   String
  difficulty    String       @default("Beginner")
  sortOrder     Int
  lessonId      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  lesson        Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

model PracticeExercise {
  id              String   @id @default(cuid())
  title           String
  scenario        String
  prompt          String
  expectedOutcome String
  hints           String[]
  difficulty      String
  tags            String[]
  moduleId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  module          Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
}

model GuidedProject {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  goal           String
  requirements   String[]
  architecture   String
  steps          String[]
  starterCode    String
  finalCode      String
  explanation    String
  testing        String
  commonMistakes String[]
  extensionIdeas String[]
  levelId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  level          Level?   @relation(fields: [levelId], references: [id], onDelete: SetNull)
}

model ToolReference {
  id          String   @id @default(cuid())
  name        String
  category    String
  url         String?
  description String
  pricing     String
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model UserProgress {
  id          String         @id @default(cuid())
  userId      String
  lessonId    String
  status      ProgressStatus @default(IN_PROGRESS)
  score       Int?
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String?
  score     Int
  total     Int
  answers   Json
  feedback  Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
}

model Achievement {
  id          String            @id @default(cuid())
  code        String            @unique
  title       String
  description String
  criteria    String
  points      Int               @default(10)
  icon        String            @default("sparkles")
  createdAt   DateTime          @default(now())
  users       UserAchievement[]
}

model UserAchievement {
  id            String      @id @default(cuid())
  userId        String
  achievementId String
  awardedAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model Certificate {
  id               String   @id @default(cuid())
  userId           String
  title            String
  verificationCode String   @unique
  issuedAt         DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RagDocument {
  id          String        @id @default(cuid())
  userId      String
  title       String
  filename    String
  mimeType    String
  text        String
  chunkSize   Int
  overlap     Int
  mode        String        @default("mock")
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks      RagChunk[]
  queryLogs   RagQueryLog[]
}

model RagChunk {
  id            String      @id @default(cuid())
  documentId    String
  chunkIndex    Int
  content       String
  tokenEstimate Int
  metadata      Json
  vector        Json
  createdAt     DateTime    @default(now())
  document      RagDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, chunkIndex])
}

model RagQueryLog {
  id              String       @id @default(cuid())
  userId          String
  documentId      String?
  question        String
  answer          String
  retrievedChunks Json
  mode            String       @default("mock")
  confidence      Float        @default(0)
  createdAt       DateTime     @default(now())
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  document        RagDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
