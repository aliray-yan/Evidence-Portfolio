# PostgreSQL — used by every service and every *-db container. No default
# on purpose, same reasoning as the gateway auth secrets below: a copied
# .env.example with this left blank fails loudly at `docker compose up`
# instead of quietly running every database on a guessable password.
# Generate one, e.g.: openssl rand -base64 24
POSTGRES_USER=legacyx
POSTGRES_PASSWORD=
POSTGRES_DB=legacy_db
POSTGRES_PORT=5432

# Gateway auth (Phase 10) — no defaults on purpose. If any of these
# aren't set, docker compose up will fail with a clear error rather than
# silently running with a guessable password. Generate a real secret for
# JWT_SECRET, e.g.: openssl rand -base64 32
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
MIGRATION_ENGINEER_USERNAME=migrator
MIGRATION_ENGINEER_PASSWORD=
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD=

# Aviation tenant — same reasoning, no defaults.
#
# The first three are operational roles: they can do their own job and read
# the routing table, but they can't cut a domain over. The last two are the
# platform roles that can — aviation's counterparts to ADMIN and
# MIGRATION_ENGINEER above. AVIATION_ADMIN is additionally the only role
# that can read aviation's audit log.
FLIGHT_DISPATCHER_USERNAME=dispatcher
FLIGHT_DISPATCHER_PASSWORD=
FLEET_MANAGER_USERNAME=fleetmgr
FLEET_MANAGER_PASSWORD=
GATE_AGENT_USERNAME=gateagent
GATE_AGENT_PASSWORD=
AVIATION_ADMIN_USERNAME=avadmin
AVIATION_ADMIN_PASSWORD=
AVIATION_MIGRATION_ENGINEER_USERNAME=avmigrator
AVIATION_MIGRATION_ENGINEER_PASSWORD=

# Pepper mixed into the salted hash of every stored passport number. Used
# by BOTH the Passenger Service (services/passenger-service) and the legacy
# monolith, which serves the same passengers API on the other side of the
# cutover — the two have to share one value or a hash written before a
# cutover wouldn't match one written after. Never the raw passport number
# itself; a leaked DB plus a leaked pepper is still useless without both.
# Generate one, e.g.: openssl rand -base64 24
PASSPORT_HASH_PEPPER=
